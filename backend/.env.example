# Copy to .env and adjust. All variables use the GEX_ prefix.

# Provider: "simulated" (default, no broker) or "ibkr" (live IB Gateway/TWS, M2-gated)
GEX_PROVIDER=simulated

# Persistence. SQLite by default so the service runs with zero infra.
# For Postgres, switch the DSN (driver: asyncpg):
# GEX_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gex
GEX_DATABASE_URL=sqlite+aiosqlite:///./gex.db
GEX_HISTORY_RETENTION_DAYS=7

# CORS — the React dev server is a different origin.
# GEX_CORS_ORIGINS='["http://localhost:5173"]'
GEX_CORS_ORIGINS=["*"]

# Universe / windowing
GEX_UNDERLYING=SPX
GEX_STRIKE_SPACING=5.0
GEX_NTM_STRIKES_EACH_SIDE=30

# Compute cadence (seconds)
GEX_RECOMPUTE_INTERVAL_S=2.0
GEX_HEARTBEAT_INTERVAL_S=10.0

# Quality thresholds
GEX_SPOT_SLA_S=10.0
GEX_DEGRADED_COVERAGE_THRESHOLD=0.80

# IBKR (only used when GEX_PROVIDER=ibkr)
GEX_IBKR_HOST=127.0.0.1
GEX_IBKR_PORT=4001
GEX_IBKR_CLIENT_ID=11
